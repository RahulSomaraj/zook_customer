name: zook_customer_app
description: "Zook — UAE's trusted secondhand marketplace (customer app)."
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ^3.9.2

dependencies:
  flutter:
    sdk: flutter

  cupertino_icons: ^1.0.8

  # State management
  flutter_bloc: ^8.1.6
  equatable: ^2.0.5

  # Navigation
  go_router: ^14.2.7

  # UI / fonts
  google_fonts: ^6.2.1

  # Networking (wired later)
  dio: ^5.7.0
  pretty_dio_logger: ^1.4.0

  # Dependency injection
  get_it: ^7.7.0

  # Local storage
  shared_preferences: ^2.3.2

  # Functional error handling
  dartz: ^0.10.1

dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^5.0.0

  # Code generation for models (wired later)
  build_runner: ^2.4.13

flutter:
  uses-material-design: true

  assets:
    - assets/images/
    - assets/icons/
